{
  "enabled": true,
  "soundRoot": "sounds",
  "soundPack": "futurama",
  "soundSubdir": "bender/direct-zip-archive-entries",
  "events": {
    "beforeSubmitPrompt": [
      "button_push.wav",
      "button_push.wav"
    ],
    "afterAgentThought": [
      "alarmloop.wav",
      "destalarm.wav"
    ],
    "afterAgentResponse": [
      "button_push.wav",
      "laser-fence-activate.wav"
    ],
    "preToolUse": "laser-fence-activate.wav",
    "postToolUse": "laser-fence-activate.wav",
    "postToolUseFailure": "button_push.wav",
    "stop": "laser-fence-activate.wav"
  }
}
