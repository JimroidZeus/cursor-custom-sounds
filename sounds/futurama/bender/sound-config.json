{
  "enabled": true,
  "soundRoot": "sounds",
  "soundPack": "futurama",
  "soundSubdir": "bender",
  "events": {
    "beforeSubmitPrompt": [
      "alarmloop.wav",
      "destalarm.wav"
    ],
    "afterAgentThought": [
      "door-small-close.wav",
      "fence-blipp.wav"
    ],
    "afterAgentResponse": [
      "laser-charge.wav",
      "laser-fence-activate.wav"
    ],
    "preToolUse": "alarmloop.wav",
    "postToolUse": "alarmloop.wav",
    "postToolUseFailure": "alarmloop.wav",
    "stop": "alarmloop.wav"
  }
}
